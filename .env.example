# Copy to .env for local development. The desktop app does NOT read this file —
# it only knows the server address (entered on the Setup screen and kept in the
# Windows Credential Manager). The server reads these from the environment, a .env
# in the working directory, or a .env next to renewal-server.exe (service installs).

# ---- required
DATABASE_URL=postgres://renewal:renewal@localhost:5432/renewal

# ---- server
BIND_ADDR=127.0.0.1:8787          # 0.0.0.0:8787 to accept LAN clients
ORG_TIMEZONE=Asia/Dubai           # "today" for expiry and the daily sweep
SCHEDULER=on                      # off = API only (no sweep, no email sending)
RUST_LOG=info,renewal_server=debug,tower_http=info,sqlx=warn
# LOG_DIR=C:\ProgramData\PropertyPilot\server\logs   # write daily log files instead of the console

# ---- HTTPS (both or neither; PEM files)
# TLS_CERT=C:\ProgramData\PropertyPilot\server\server.crt
# TLS_KEY=C:\ProgramData\PropertyPilot\server\server.key

# ---- email: log | smtp | graph
MAIL_PROVIDER=log
MAIL_FROM_NAME=Leasing Department
MAIL_FROM_ADDRESS=leasing@example.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=leasing@example.com
# SMTP_PASSWORD=app-password
# SMTP_STARTTLS=true
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=leasing@example.com
